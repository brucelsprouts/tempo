# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TEMPO_TIMEZONE=America/Toronto

# Web push. Generate the pair with `npx web-push generate-vapid-keys`.
# The public key ships in the bundle by design — it identifies the server to the
# push service and can do nothing on its own.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# server only
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push service uses if delivery goes wrong. Must be a
# mailto: or https: URL — Apple rejects the subscription if it is neither.
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for /api/push/dispatch, which pg_cron calls on a timer. That
# route is not behind the login gate, so this is the only thing protecting it.
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
